{
  "name": "typebridge",
  "version": "0.0.0",
  "description": "Browser-based transliteration editor",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-standalone.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write editor.html \"src/**/*.css\"",
    "format:check": "prettier --check editor.html \"src/**/*.css\"",
    "build:standalone-viewer": "node scripts/build-standalone.mjs",
    "test:standalone": "playwright test -c playwright.standalone.config.ts"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "3.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "dependencies": {
    "@vchernoy/active-runtime": "0.7.0",
    "@vchernoy/calc": "0.7.0",
    "@vchernoy/remark-active": "0.7.0",
    "katex": "0.19.1"
  }
}
